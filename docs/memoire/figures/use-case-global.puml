@startuml use-case-global
left to right direction
skinparam packageStyle rectangle
title Global use-case diagram — NexusVPN

actor "Visitor" as V
actor "User (client)" as U
actor "Administrator" as A
actor "Chargily Pay" as C <<external>>
actor "Scheduler" as S <<system>>

rectangle "NexusVPN portal" {
  usecase "Browse VPN offers" as UC1
  usecase "Register\n(+ 7-day trial)" as UC2
  usecase "Authenticate\n(login / logout / reset)" as UC3
  usecase "Verify e-mail" as UC4
  usecase "Subscribe & checkout" as UC5
  usecase "Process payment" as UC6
  usecase "Get VPN configuration" as UC7
  usecase "Manage subscription" as UC8
  usecase "Manage account" as UC9
  usecase "Contact the company" as UC10
  usecase "Administer the platform\n(users, offers, billing,\nmoderation, audit, support)" as UC11
  usecase "Expire & remind\n(scheduled)" as UC12
}

V --> UC1
V --> UC2
V --> UC10
U --> UC1
U --> UC3
U --> UC5
U --> UC7
U --> UC8
U --> UC9
U --> UC10
A --> UC3
A --> UC11
S --> UC12

UC2 ..> UC4 : <<include>>
UC5 ..> UC6 : <<include>>
UC6 --> C
UC7 .> UC4 : <<extend>>\n(verified e-mail)

note bottom of UC11
  The single Admin role covers the five business
  roles — SysAdmin, Sales, Contract & Billing,
  Technical Support (G-01).
end note
note as NMOB
  Mobile client (Flutter) — POSTPONED:
  will reach UC3/UC5/UC7/UC8 over the token API.
end note
@enduml
