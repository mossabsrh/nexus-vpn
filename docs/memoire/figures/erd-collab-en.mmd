%% ERD NexusVPN — Part B: teams, support and audit. From the real schema (php artisan db:table).
%% Split from the full ERD for print readability. The team-coverage link
%% SUBSCRIPTIONS |o--o| TEAMS ("covers", SET NULL) is shown in Part A / the relational model (III.8).
erDiagram
    USERS {
        int id PK
        string name
        string email UK
        string role "user | admin"
        datetime email_verified_at
    }
    TEAMS {
        int id PK
        string name
        int owner_id FK
        int subscription_id FK "nullable"
    }
    TEAM_USER {
        int team_id PK, FK
        int user_id PK, FK
        string role "owner | member"
        datetime created_at
    }
    TESTIMONIALS {
        int id PK
        int user_id FK
        text content
        string status "pending | approved | rejected"
        int moderated_by FK "nullable"
        datetime moderated_at
    }
    CONTACT_REQUESTS {
        int id PK
        int user_id FK "nullable"
        string name
        string email
        string company
        int seats
        text message
        string status "new | handled"
        int handled_by FK "nullable"
        datetime handled_at
        string ip_address
    }
    AUDIT_LOGS {
        int id PK
        int actor_id FK "nullable"
        string action
        string subject_type
        int subject_id
        text metadata "JSON"
        string ip_address
        datetime created_at
    }
    PERSONAL_ACCESS_TOKENS {
        int id PK
        string tokenable_type "mobile (POSTPONED)"
        int tokenable_id
        string token UK
        datetime expires_at
    }

    USERS ||--o{ TEAMS : "owns (CASCADE)"
    TEAMS ||--o{ TEAM_USER : "contains (CASCADE)"
    USERS ||--o{ TEAM_USER : "member of (CASCADE)"
    USERS ||--o{ TESTIMONIALS : "writes (CASCADE)"
    USERS |o--o{ TESTIMONIALS : "moderates (SET NULL)"
    USERS |o--o{ CONTACT_REQUESTS : "sends (SET NULL)"
    USERS |o--o{ CONTACT_REQUESTS : "handles (SET NULL)"
    USERS |o--o{ AUDIT_LOGS : "actor (SET NULL)"
    USERS |o--o{ PERSONAL_ACCESS_TOKENS : "owns (postponed)"
